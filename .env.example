# Configuration for On Record. Copy to .env when running the application.
# Graph query definitions and local database setup are available; the API arrives in a later PR.

# --- FalkorDB ----------------------------------------------------------------
# Local FalkorDB connection: docker compose up -d --wait falkordb
# Cloud: falkor://default:<password>@<host>:<port>  (Railway / FalkorDB Cloud; use falkors:// for TLS)
WSW_FALKORDB_URL=falkor://127.0.0.1:6379
WSW_GRAPH=wsw_demo

# --- Gemma 4 ---------------------------------------------------------------------
# auto = Gemini API if GEMINI_API_KEY is set, else local Ollama if gemma4 is pulled, else a deterministic fake.
WSW_LLM_PROVIDER=auto
# Hosted Gemma 4 (text): https://aistudio.google.com/apikey
GEMINI_API_KEY=
WSW_GEMINI_MODEL=gemma-4-31b-it
# Local Gemma 4 with native audio input (hears spoken questions): `ollama pull gemma4:e4b`
WSW_OLLAMA_URL=http://127.0.0.1:11434
WSW_OLLAMA_MODEL=gemma4:e4b
# auto | ollama | whisper  (who transcribes spoken questions)
WSW_QUESTION_AUDIO=auto
# Optional OpenAI-compatible Gemma 4 endpoint (e.g. DigitalOcean Serverless Inference)
WSW_OPENAI_BASE_URL=
WSW_OPENAI_API_KEY=
WSW_OPENAI_MODEL=gemma-4-31B-it

# --- Embeddings ------------------------------------------------------------------
# gemma = EmbeddingGemma-300m ONNX (CPU); hash = offline word hashing
WSW_EMBEDDER=gemma
WSW_EMBED_REPO=onnx-community/embeddinggemma-300m-ONNX
WSW_EMBED_DIM=768

# --- Listener (who said what) ----------------------------------------------------
WSW_ASR_MODEL=small
WSW_ASR_DEVICE=cpu
WSW_ASR_COMPUTE=int8
WSW_SPEAKER_MODEL=speaker_embedding_en.onnx
WSW_SPEAKER_THRESHOLD=0.55

# --- App -------------------------------------------------------------------------
WSW_SEED_DEMO=false
# Comma-separated origins allowed to call the API from other sites (same-origin always works)
WSW_CORS_ORIGINS=

# --- Access settings for the upcoming API -----------------------------------------
# Unset: anyone can create/capture meetings; demo meetings stay protected.
# Set: only the operator (token via header or POST /api/auth cookie) can change anything.
WSW_ADMIN_TOKEN=
WSW_CREATE_LIMIT=30
WSW_ALLOWED_HOSTS=
